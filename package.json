{
  "name": "@lumirelle/oxlint-config",
  "type": "module",
  "version": "0.13.0",
  "packageManager": "nub@0.7.5",
  "description": "Lumirelle's opinionated OXLint config",
  "author": "Lumirelle <shabbyacc@outlook.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/lumirelle",
  "homepage": "https://github.com/lumirelle/oxlint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumirelle/oxlint-config.git"
  },
  "bugs": "https://github.com/lumirelle/oxlint-config/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./ts": "./.oxlintrc.ts.json",
    "./vue": "./.oxlintrc.vue.json",
    "./package.json": "./package.json"
  },
  "files": [
    ".oxlintrc.ts.json",
    ".oxlintrc.vue.json",
    "internal"
  ],
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">22",
    "bun": ">1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@antfu/eslint-config": ">=9.1.0",
    "eslint-plugin-oxlint": ">=1.73.0",
    "oxlint": ">=1.73.0",
    "oxlint-tsgolint": ">=0.23.0"
  },
  "peerDependenciesMeta": {
    "@antfu/eslint-config": {
      "optional": true
    },
    "eslint-plugin-oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@lumirelle/tsconfig": "^0.1.6",
    "@oxlint/migrate": "^1.78.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^12.2.0",
    "changelogithub": "^15.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "knip": "^6.32.2",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pkg-pr-new": "^0.0.87",
    "publint": "^0.3.23",
    "taze": "^20.0.1",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.12.tsgo.7.0.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
